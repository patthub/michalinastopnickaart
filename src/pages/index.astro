---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import KartaProduktu from '../components/KartaProduktu.astro';
import { link } from '../lib/url';

// Wizytówka pracowni. Treść fikcyjna — do podmiany.
const linkiZewnetrzne = [
  { etykieta: 'Instagram', url: 'https://instagram.com' },
  { etykieta: 'E-mail', url: 'mailto:pracownia@ziarno.example' },
  { etykieta: 'Warsztaty', url: 'https://example.com' },
];

const produkty = (await getCollection('produkty')).sort(
  (a, b) => a.data.kolejnosc - b.data.kolejnosc
);
const zajawka = produkty.slice(0, 3);
---

<Base
  tytul="Pracownia"
  opis="Michalina Stopnicka — ceramika użytkowa i rzeźba. Wyroby toczone i formowane ręcznie, wypalane w piecu gazowym."
>
  <section class="mx-auto max-w-5xl px-5 pt-12 pb-16 grid gap-10 md:grid-cols-2 md:items-center">
    <div class="naroznik overflow-hidden bg-kosc border border-popiol/20 order-1 md:order-2">
      <img
        src={link('/img/produkty/pracownia.svg')}
        alt="Wnętrze pracowni ceramicznej Michaliny Stopnickiej"
        width="640"
        height="800"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="order-2 md:order-1">
      <p class="display text-xs text-glina mb-4">Pracownia ceramiki</p>
      <h1 class="display text-4xl md:text-5xl leading-tight m-0">Michalina Stopnicka</h1>
      <p class="mt-6 text-lg text-popiol leading-relaxed">
        Toczymy i formujemy ręcznie naczynia, wazony, kafle i drobną rzeźbę.
        Każdy wyrób powstaje w małej serii — od gliny surowej, przez szkliwo z
        popiołu, po wypał w piecu gazowym. Zależy nam na przedmiotach, które
        dobrze leżą w dłoni i starzeją się z wdziękiem.
      </p>
      <ul class="mt-8 flex flex-wrap gap-3 list-none p-0 m-0">
        {
          linkiZewnetrzne.map((l) => (
            <li>
              <a
                href={l.url}
                class="display text-xs inline-block px-4 py-2.5 border border-atrament text-atrament no-underline hover:bg-atrament hover:text-tlo transition-colors"
              >
                {l.etykieta}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8">
    <div class="flex items-baseline justify-between border-b border-popiol/25 pb-3 mb-8">
      <h2 class="display text-lg m-0">Z katalogu</h2>
      <a href={link('/katalog')} class="display text-xs text-glina no-underline">Zobacz wszystko →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {zajawka.map((p) => <KartaProduktu produkt={p} />)}
    </div>
  </section>
</Base>
